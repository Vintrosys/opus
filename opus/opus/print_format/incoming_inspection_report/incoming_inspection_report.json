 "html": "<style>\r\ntable { width: 100%; border-collapse: collapse; font-size: 12px; }\r\ntd, th { border: 1px solid black; padding: 4px; }\r\n.header td { border: none; }\r\n.center { text-align: center; }\r\n.bold { font-weight: bold; }\r\n</style>\r\n\r\n<h3 class=\"center\">INCOMING INSPECTION REPORT</h3>\r\n\r\n<table class=\"header\">\r\n<tr>\r\n  <td class=\"bold\">Article No:</td><td>{{ doc.item_code }}</td>\r\n  <td class=\"bold\">Doc No:</td><td>{{ doc.name }}</td>\r\n</tr>\r\n<tr>\r\n  <td class=\"bold\">Article Name:</td><td>{{ doc.item_name }}</td>\r\n  <td class=\"bold\">Rev No:</td><td>{{ doc.revision or \"-\" }}</td>\r\n</tr>\r\n<tr>\r\n  <td class=\"bold\">Supplier:</td><td>{{ doc.supplier }}</td>\r\n  <td class=\"bold\">Date:</td><td>{{ doc.inspection_date }}</td>\r\n</tr>\r\n<tr>\r\n  <td class=\"bold\">Material Description:</td><td>{{ doc.description }}</td>\r\n  <td class=\"bold\">GRN No:</td><td>{{ doc.reference_name }}</td>\r\n</tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<table>\r\n<tr class=\"bold center\">\r\n  <td>S.No</td>\r\n  <td>Characteristics</td>\r\n  <td>Specification</td>\r\n  <td>Checking Method</td>\r\n  <td colspan=\"5\">Observations</td>\r\n  <td>Result</td>\r\n  <td>Remarks</td>\r\n</tr>\r\n\r\n{% for row in doc.readings %}\r\n<tr>\r\n  <td class=\"center\">{{ loop.index }}</td>\r\n  <td>{{ row.specification }}</td>\r\n  <td>{{ row.min_value }} - {{ row.max_value }}</td>\r\n  <td>{{ row.method }}</td>\r\n\r\n  <td></td><td></td><td></td><td></td><td></td>\r\n\r\n  <td class=\"center\">{{ row.status }}</td>\r\n  <td>{{ row.notes }}</td>\r\n</tr>\r\n{% endfor %}\r\n</table>\r\n\r\n<br>\r\n\r\n<table>\r\n<tr>\r\n  <td class=\"bold\">Reason For Rejection:</td>\r\n  <td colspan=\"3\">{{ doc.rejection_reason or \"\" }}</td>\r\n</tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<table>\r\n<tr>\r\n  <td class=\"bold\">Accepted Qty:</td><td>{{ doc.accepted_qty }}</td>\r\n  <td class=\"bold\">Rejected Qty:</td><td>{{ doc.rejected_qty }}</td>\r\n</tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<table>\r\n<tr style=\"height: 60px;\">\r\n  <td class=\"center bold\">Inspected & Approved By</td>\r\n</tr>\r\n</table>",
